---
// チュートリアルの動画・動く絵を貼る。
//
// ファイルは docs/public/tutorials/ に置き、src にはそこからの名前を書く
// (例: src="opna-first-sound.mp4")。拡張子で貼り方を変える。
//
//   .mp4 / .webm : 再生ボタン付きの動画 (自動では流さない)
//   .gif / .png / .jpg / .webp : 絵としてそのまま出す
//
// サイトは /2686V_2686VFX/ の下に置かれるので、頭はここで足す。
// http から始まるものと、/ から始まるものは書かれたまま使う。
interface Props {
	src: string;

	// 下に添える説明。読み上げにも使う
	caption?: string;

	// 動画を流す前に出す絵 (docs/public/tutorials/ からの名前)
	poster?: string;
}

const { src, caption, poster } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const urlOf = (name: string) =>
	/^https?:\/\//.test(name) || name.startsWith('/') ? name : `${base}/tutorials/${name}`;

const isVideo = /\.(mp4|webm)$/i.test(src);
---

<figure class="tutorial-media">
	{
		isVideo ? (
			<video controls preload="metadata" playsinline src={urlOf(src)} poster={poster ? urlOf(poster) : undefined} aria-label={caption} />
		) : (
			<img src={urlOf(src)} alt={caption ?? ''} loading="lazy" />
		)
	}
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.tutorial-media {
		margin: 1.5rem 0;
	}

	.tutorial-media video,
	.tutorial-media img {
		display: block;
		width: 100%;
		max-width: 60rem;
		height: auto;
		border-radius: 0.375rem;
		border: 1px solid var(--sl-color-gray-5);
	}

	.tutorial-media figcaption {
		margin-top: 0.5rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
</style>
