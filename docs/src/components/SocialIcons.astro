---
// ヘッダーの右端。Starlight のものをそのまま出したうえで、
// サイドバーの表示・非表示のボタンを足す。
//
// ここへ置いているのは、ヘッダーの中で差し替えられる場所のうち、
// テーマ切り替えのとなりに並ぶのがここだから。
//
// 押したときの動きは astro.config.mjs の head に置いてある。ボタンは
// ページごとに出るので、document へ 1 つだけ聞き手を付けるほうが確実。
import Default from '@astrojs/starlight/components/SocialIcons.astro';

const label = Astro.currentLocale === 'en' ? 'Toggle sidebar' : 'サイドバーの表示切り替え';
---

<Default><slot /></Default>

<button type="button" class="sidebar-toggle" aria-pressed="false" aria-label={label} title={label}>
	<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none"
		stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2" />
		<line x1="9" y1="4" x2="9" y2="20" />
	</svg>
</button>
